{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "station_hour_v1.schema.json",
  "title": "station_hour_v1",
  "description": "按（来源站点, UTC小时）聚合的小时特征/标签表发布行。energyKwh 为两位 HALF_UP 字符串；未知小时用 observationKind=MISSING 且 energyKwh=null 表达，禁止自动填 0。JSON 发布行与 MR 的 staging TSV 列一一对应（见 docs/stage2/contracts.md 映射表）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "datasetVersion",
    "runId",
    "analysisStationId",
    "hourStartUtc",
    "energyKwh",
    "meanPowerKw",
    "sessionStartCount",
    "coverageSeconds",
    "observationKind",
    "dataMode",
    "nullReasons"
  ],
  "properties": {
    "datasetVersion": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1, "description": "产生该行的 run 目录，可与 datasetVersion 一起追溯。" },
    "analysisStationId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9_.\\-]+$"
    },
    "hourStartUtc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:00:00Z$",
      "description": "整点小时起点，UTC。"
    },
    "energyKwh": {
      "type": ["string", "null"],
      "pattern": "^[0-9]+\\.[0-9]{2}$",
      "description": "小时电量 kWh 两位字符串；MISSING 小时为 null。"
    },
    "meanPowerKw": {
      "type": ["string", "null"],
      "pattern": "^[0-9]+\\.[0-9]{2}$",
      "description": "该小时平均功率 kW 两位字符串；MISSING 或无法计算时为 null。"
    },
    "sessionStartCount": {
      "type": "integer",
      "minimum": 0,
      "description": "该小时开始的会话数；跨小时会话只在起始小时计一次。"
    },
    "coverageSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3600,
      "description": "观测覆盖秒数，来自每站区间并集，不是多桩覆盖秒数之和。"
    },
    "observationKind": {
      "type": "string",
      "enum": ["METER_INTERVAL", "SESSION_ALLOCATED", "PUBLIC_HOURLY", "MISSING"],
      "description": "MISSING 表示该小时无观测，不是 0 负荷。"
    },
    "dataMode": {
      "type": "string",
      "enum": ["SIMULATED", "REAL_ANONYMIZED", "PUBLIC_AGGREGATED"]
    },
    "availablePiles": { "type": ["integer", "null"], "minimum": 0 },
    "capacityPiles": { "type": ["integer", "null"], "minimum": 1 },
    "occupiedPiles": { "type": ["integer", "null"], "minimum": 0 },
    "nullReasons": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "enum": ["energyKwh", "meanPowerKw", "availablePiles", "capacityPiles", "occupiedPiles"]
      },
      "additionalProperties": {
        "type": "string",
        "enum": ["NOT_COLLECTED", "NOT_APPLICABLE", "ANOMALY"]
      },
      "description": "可空字段为 null 时必须说明原因。"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "observationKind": { "const": "MISSING" } } },
      "then": {
        "properties": {
          "energyKwh": { "type": "null" },
          "sessionStartCount": { "const": 0 }
        }
      }
    },
    {
      "if": { "properties": { "energyKwh": { "type": "null" } }, "required": ["energyKwh"] },
      "then": {
        "properties": { "nullReasons": { "required": ["energyKwh"] } },
        "required": ["nullReasons"]
      }
    },
    {
      "if": { "properties": { "capacityPiles": { "type": "null" } }, "required": ["capacityPiles"] },
      "then": { "properties": { "nullReasons": { "required": ["capacityPiles"] } } }
    },
    {
      "if": { "properties": { "meanPowerKw": { "type": "null" } }, "required": ["meanPowerKw"] },
      "then": { "properties": { "nullReasons": { "required": ["meanPowerKw"] } } }
    },
    {
      "if": { "properties": { "availablePiles": { "type": "null" } }, "required": ["availablePiles"] },
      "then": { "properties": { "nullReasons": { "required": ["availablePiles"] } } }
    },
    {
      "if": { "properties": { "occupiedPiles": { "type": "null" } }, "required": ["occupiedPiles"] },
      "then": { "properties": { "nullReasons": { "required": ["occupiedPiles"] } } }
    }
  ]
}
