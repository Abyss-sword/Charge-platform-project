QWidget { color: @Text@; font-size: @Body@px; }
QMainWindow, QWidget#shell, QWidget#scrollContent, QScrollArea { background: @Background@; }
QLabel { background: transparent; }
QLabel[role="title"] { color: @Brand@; font-size: @Title@px; font-weight: bold; }
QLabel[role="section"] { color: @Brand@; font-size: @Section@px; font-weight: bold; }
QLabel[role="caption"] { color: @Secondary@; font-size: @Caption@px; }
QFrame[role="card"] { background: @Card@; border: 1px solid @Border@; border-radius: @CardRadius@px; }
QFrame[role="hero"] { background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 @Brand@,stop:1 @HeroEnd@); border-radius: @HeroRadius@px; }
QFrame[role="hero"] QLabel { color: @Card@; }
QFrame#mobilePageHeader, QFrame#bottomNavigationBar { background: @Card@; border: 1px solid @Border@; }
QFrame#adminTopBar { background: @Card@; border-bottom: 1px solid @Border@; }
QFrame#adminSidebar { background: @Brand@; }
QFrame#adminSidebar QLabel { color: @Card@; }
QToolButton[role="adminNavigation"] { color: @Card@; border: 0; text-align: left; padding: 8px 12px; border-radius: @Radius@px; }
QToolButton[role="adminNavigation"]:checked { background: @Action@; font-weight: bold; }
QTableView, QTableWidget { background: @Card@; alternate-background-color: @Background@; border: 1px solid @Border@; gridline-color: @Border@; }
QHeaderView::section { background: @Brand@; color: @Card@; padding: 6px 8px; border: 0; }
QDialog#confirmDialog { background: @Card@; border: 1px solid @Border@; border-radius: @CardRadius@px; }
QDialog#confirmDialog QPushButton[role="danger"] { background: @Error@; color: @Card@; font-weight: bold; }
QFrame#toast { background: @Card@; border: 1px solid @Border@; border-radius: @Radius@px; padding: 4px; }
QFrame#toast[toastType="0"] { border-color: @Charging@; }
QFrame#toast[toastType="1"] { border-color: @Action@; }
QFrame#toast[toastType="2"] { border-color: @Warning@; }
QFrame#toast[toastType="3"] { border-color: @Error@; }
QPushButton, QToolButton { background: @Card@; color: @Action@; border: 1px solid @Border@; border-radius: @Radius@px; padding: 6px 8px; }
QPushButton:hover, QToolButton:hover { border-color: @Action@; }
QPushButton:pressed, QToolButton:pressed { background: @Background@; }
QPushButton:focus, QToolButton:focus { border: 2px solid @Action@; }
QPushButton:disabled, QToolButton:disabled { color: @Secondary@; background: @Background@; }
QPushButton[role="primary"] { background: @Charging@; color: @Brand@; font-weight: bold; }
QToolButton[role="navigation"] { border: 0; border-top: 3px solid @Card@; border-radius: 0; padding: 4px 0; }
QToolButton[role="navigation"]:checked { color: @Brand@; background: @Background@; border-top: 3px solid @Charging@; font-weight: bold; }
QToolButton[role="navigation"]:focus { border-bottom: 2px solid @Action@; }
QLineEdit, QComboBox { background: @Card@; border: 1px solid @Border@; border-radius: @Radius@px; padding: 6px; }
QLineEdit:focus { border-color: @Action@; }
QLineEdit[invalid="true"] { border-color: @Error@; }
QScrollArea { border: 0; }
QLabel[badge="true"] { border: 1px solid @Border@; border-radius: @Radius@px; padding: 4px 8px; color: @Brand@; background: @Card@; font-size: @Caption@px; }
QLabel[tone="success"] { border-color: @Charging@; }
QLabel[tone="info"] { border-color: @Action@; }
QLabel[tone="warning"] { border-color: @Warning@; }
QLabel[tone="error"] { border-color: @Error@; }

/* Keep operator sidebar navigation readable after the generic button rules. */
QFrame#adminSidebar QToolButton[role="adminNavigation"] {
    background: transparent;
    color: @Card@;
    border: 0;
    text-align: left;
    padding: 8px 12px;
    border-radius: @Radius@px;
}
QFrame#adminSidebar QToolButton[role="adminNavigation"]:hover {
    background: @HeroEnd@;
    color: @Card@;
}
QFrame#adminSidebar QToolButton[role="adminNavigation"]:pressed {
    background: @Action@;
    color: @Card@;
}
QFrame#adminSidebar QToolButton[role="adminNavigation"]:checked {
    background: @Action@;
    color: @Card@;
    font-weight: bold;
}
QFrame#adminSidebar QToolButton[role="adminNavigation"]:disabled {
    background: transparent;
    color: @Border@;
}
