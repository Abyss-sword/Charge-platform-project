{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "jsx": "preserve", "resolveJsonModule": true, "esModuleInterop": true, "lib": ["ESNext", "DOM", "ESNext.Disposable"],
    "types": ["node", "vitest/globals"], "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "tests/**/*.ts"]
}
